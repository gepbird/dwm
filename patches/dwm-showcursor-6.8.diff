+/* Give the mouse cursor back when a stopped or crashed client (usually a
+ * game) left a blank cursor defined on its window: reset the root cursor and
+ * undefine the cursor on the top-level window of the focused client and of
+ * the client under the pointer (they differ e.g. after a keyboard focus
+ * change), so they inherit dwm's normal root cursor again. Cursors defined on
+ * child windows and XFixesHideCursor are not undone. Cannot break an active
+ * pointer grab of another client, see the XF86Ungrab keybind in config.h for
+ * that. A running client that keeps hiding the cursor will just hide it
+ * again. */
+void
+showcursor(const Arg *arg)
+{
+	Client *c;
+	Window r, child;
+	int x, y;
+	unsigned int mask;
+
+	XDefineCursor(dpy, root, cursor[CurNormal]->cursor);
+	if (selmon->sel)
+		XUndefineCursor(dpy, selmon->sel->win);
+	if (XQueryPointer(dpy, root, &r, &child, &x, &y, &x, &y, &mask)
+	&& (c = wintoclient(child)) && c != selmon->sel)
+		XUndefineCursor(dpy, c->win);
+	XSync(dpy, False);
+}
