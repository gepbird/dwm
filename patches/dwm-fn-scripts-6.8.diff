diff --git a/chbright.sh b/chbright.sh
new file mode 100755
index 0000000..807a299
--- /dev/null
+++ b/chbright.sh
@@ -0,0 +1,7 @@
+#!/bin/sh
+percentage=$(brightnessctl --machine-readable set "$@" | cut -d, -f4)
+dunstify \
+  -u low \
+  -h string:x-dunst-stack-tag:backlight \
+  -h int:value:"$percentage" \
+  "Brightness: ${percentage}"
diff --git a/chvol.sh b/chvol.sh
new file mode 100755
index 0000000..6f1d43f
--- /dev/null
+++ b/chvol.sh
@@ -0,0 +1,7 @@
+#!/bin/sh
+# usage: chvol.sh <pamixer args>, e.g. -i 10, -d 1, -t
+pamixer --allow-boost --set-limit 150 "$@"
+volume=$(pamixer --get-volume)
+output="Volume: $volume%"
+[ "$(pamixer --get-mute)" = true ] && output="$output (muted)"
+dunstify -a "changeVolume" -u low -h string:x-dunst-stack-tag:volume -h int:value:"$volume" "$output"
